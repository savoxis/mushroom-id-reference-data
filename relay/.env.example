# Copy to .env and fill in real values. Never commit the real .env file --
# add it to .gitignore in this folder (or don't put secrets in a file at
# all; set them directly as environment variables on whatever's running
# the container on your UnRAID box, same as you'd do for any other
# service's credentials).

# Fine-grained GitHub PAT, scoped to ONLY this one repo:
#   GitHub -> Settings -> Developer settings -> Personal access tokens ->
#   Fine-grained tokens -> Generate new token
#   Repository access: "Only select repositories" ->
#     savoxis/mushroom-identifier-dontusethisever
#   Permissions: Repository permissions -> Contents -> Read and write
#   Everything else: No access
# That's it -- this token can read/write file contents in that one repo
# and nothing else. It can't touch other repos, can't manage the repo's
# settings, can't read your account, can't do anything outside Contents.
GITHUB_PAT=

# A long random string the skill sends as "Authorization: Bearer <this>".
# NOT the GitHub PAT -- a separate, lower-stakes secret scoped only to
# "can call this relay's one endpoint." Generate one with, e.g.:
#   openssl rand -hex 32
RELAY_AUTH_TOKEN=

# Defaults below match the repo this relay was built for -- only change
# these if you fork/rename it.
GITHUB_REPO=savoxis/mushroom-identifier-dontusethisever
GITHUB_BRANCH=main
LOG_PATH_IN_REPO=logs/finds_log.jsonl
RATE_LIMIT_PER_MINUTE=20
